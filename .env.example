# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays server-side.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Buffer credential storage, the publishing ledger and account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (required for research analysis, drafting, Guardian AI review, voice analysis)
# Free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-3.5-flash (a free-tier Flash model)
GEMINI_MODEL=

# Buffer OAuth (optional if you connect with a personal API key instead)
# Register the app at https://developers.buffer.com and set this exact redirect URI.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Defaults to ${NEXT_PUBLIC_APP_URL}/api/buffer/callback
BUFFER_REDIRECT_URI=
# Required for any Buffer connection. 32 random bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BUFFER_TOKEN_ENCRYPTION_KEY=

# Transcription (optional; without it, voice notes can be recorded but must be typed)
TRANSCRIPTION_PROVIDER=deepgram
TRANSCRIPTION_API_KEY=
